# Optional — copilot and evals work without these (deterministic mode).
# Evals always force deterministic and ignore keys.
# LLM_PROVIDER=openai|anthropic|gemini
# If LLM_PROVIDER is unset, the first key present wins (openai → anthropic → gemini).

OPENAI_API_KEY=your_key_here
OPENAI_MODEL=gpt-4.1-mini

ANTHROPIC_API_KEY=your_key_here
ANTHROPIC_MODEL=claude-sonnet-4-5

GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.5-flash

PORT=3001

# Future: embedding-based document retrieval (not wired yet).
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
